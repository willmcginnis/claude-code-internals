#!/usr/bin/env python3
"""Slice fixed-string matches out of a Claude Code strings dump.

The Bun-compiled binary yields a handful of enormous single-line JS blobs, so
line-oriented tools (grep -n) tell you *which* line but not *where in it*.
This walks the file with str.find (no regex, per coding-style) and prints a
character window around each hit.

    ccstr <needle> [--window N] [--max M] [--file PATH]
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

DEFAULT_DUMP = Path("/tmp/cc220-strings-a.txt")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("needle", nargs="?")
    ap.add_argument("--window", type=int, default=600)
    ap.add_argument("--max", type=int, default=5)
    ap.add_argument("--file", type=Path, default=DEFAULT_DUMP)
    ap.add_argument("--at", type=int, help="raw char offset to slice from")
    ap.add_argument("--len", type=int, default=4000, dest="length")
    args = ap.parse_args()

    if not args.file.exists():
        print(f"dump not found: {args.file}", file=sys.stderr)
        return 2

    text = args.file.read_text(errors="replace")

    if args.at is not None:
        print(text[args.at : args.at + args.length])
        return 0

    if args.needle is None:
        ap.error("need a needle or --at")
    start = 0
    found = 0
    while found < args.max:
        idx = text.find(args.needle, start)
        if idx == -1:
            break
        found += 1
        lo = max(0, idx - args.window)
        hi = min(len(text), idx + len(args.needle) + args.window)
        print(f"########## hit {found} @ char {idx} ##########")
        print(text[lo:hi])
        print()
        start = idx + len(args.needle)

    if found == 0:
        print(f"no hits for {args.needle!r}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
